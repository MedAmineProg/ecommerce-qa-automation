# Copy this file to .env and adjust as needed.
BASE_URL=https://automationexercise.com
API_BASE_URL=https://automationexercise.com/api

# Only needed for `npm run export:squashtm -- --push` — live-pushing results
# into a real SquashTM instance (src/reporting/squashtm-exporter). CSV
# export works without any of this. See that module's README for how to
# mint SQUASHTM_API_TOKEN and find SQUASHTM_ITERATION_ID; there is no
# username/password variable because SquashTM's REST API rejects Basic auth
# outright on current versions — Bearer token is the only auth that works.
SQUASHTM_BASE_URL=http://localhost:8090/squash
SQUASHTM_API_TOKEN=
SQUASHTM_ITERATION_ID=
