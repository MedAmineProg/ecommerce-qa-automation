{
  "name": "ecommerce-qa-automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript E2E and API test automation framework built against automationexercise.com, using the Page Object Model pattern.",
  "scripts": {
    "launch": "node scripts/launcher.js",
    "test": "playwright test",
    "posttest": "node scripts/push-squashtm-if-configured.js",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "posttest:headed": "node scripts/push-squashtm-if-configured.js",
    "test:chromium": "playwright test --project=chromium",
    "test:chromium:headed": "playwright test --project=chromium --headed",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test tests/api",
    "test:unit": "jest",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://automationexercise.com",
    "export:squashtm": "playwright test && ts-node src/reporting/squashtm-exporter/src/index.ts playwright-json-report.json squashtm-import.csv"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@playwright/test": "^1.48.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
