# Copy this file to squashtm/.env before running docker compose up.
DB_USER=squashtm
DB_PASSWORD=MustB3Ch4ng3d
DB_DATABASE=squashtm

# Required for Personal API tokens to work at all — without it, SquashTM's
# own UI fails token creation with "No JWT secret is defined for this
# instance." Must be base64, >=512 bits (SquashTM itself enforces this and
# refuses to start otherwise). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
SQUASH_REST_API_JWT_SECRET=
